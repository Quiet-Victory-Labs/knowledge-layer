# Generate a unique local .env with: uv run python scripts/init_env.py
POSTGRES_PASSWORD=replace-with-unique-local-secret
KNOWLEDGE_AGENT_TOKEN=replace-with-unique-local-secret
# Reviewed delegation is opt-in and requires OIDC mode; token mode refuses it.
KNOWLEDGE_AGENT_AUTONOMY=0
# Optional only when adopting an existing deployment volume:
# KNOWLEDGE_DATA_VOLUME=existing-volume-name
# KNOWLEDGE_DATA_VOLUME_EXTERNAL=true
# KNOWLEDGE_DB_USER=existing-db-user
# KNOWLEDGE_DB_NAME=existing-db-name
