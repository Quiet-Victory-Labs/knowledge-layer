# References only; copy outside Git, owned/readable by the trusted coordinator.
KNOWLEDGE_AUTH_MODE=oidc
DATABASE_URL_FILE=/etc/knowledge-layer/registry-url
KNOWLEDGE_SOURCE_POLICY_FILE=/etc/knowledge-layer/source-policy.json
KNOWLEDGE_ENABLED_KINDS=sql_catalog
KNOWLEDGE_WORKER_TENANT=organization
KNOWLEDGE_WORKER_CONNECTION_IDS=conn_operator_selected
KNOWLEDGE_SOURCE_SELECTED_FILE=/etc/knowledge-layer/selected-source.json
KNOWLEDGE_CONNECTOR_RUNTIME=container
# Replace with a locally built and independently reviewed immutable image.
KNOWLEDGE_CONNECTOR_IMAGE=registry.example/knowledge-layer@sha256:REPLACE_WITH_64_HEX_CHARACTERS
# Default none denies outbound networking. Provision a named per-source network
# and host/VPC firewall for exactly the source's approved HTTPS endpoints.
KNOWLEDGE_CONNECTOR_NETWORK=none
