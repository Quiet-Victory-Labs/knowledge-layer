# Operator settings only; inject secrets by named Secret Manager version.
KNOWLEDGE_AUTH_MODE: "iap"
KNOWLEDGE_IAP_AUDIENCE: "/projects/YOUR_PROJECT_NUMBER/locations/us-central1/services/knowledge-layer"
KNOWLEDGE_OIDC_ALLOWED_GROUP: "knowledge-users"
KNOWLEDGE_OIDC_STEWARD_GROUP: "knowledge-stewards"
# Configure after service discovery; writes and remote MCP refuse until set.
KNOWLEDGE_PUBLIC_URL: "https://YOUR_SERVICE.run.app"
# Source IO stays disabled until a separately qualified worker exists.
KNOWLEDGE_ENABLED_KINDS: ""
KNOWLEDGE_AGENT_ALLOWED_KINDS: ""
KNOWLEDGE_AGENT_SOURCE_MANAGEMENT: "0"
