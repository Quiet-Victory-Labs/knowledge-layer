# syntax=docker/dockerfile:1
# Keep the upstream package inventory and initialization implementation intact.
FROM postgres:18.6-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873

USER 0
RUN set -eu; \
    test "$(cat /etc/alpine-release)" = 3.24.2; \
    test -f /usr/local/bin/gosu; \
    test ! -L /usr/local/bin/gosu; \
    mkdir -p /usr/share/knowledge-layer; \
    cp /lib/apk/db/installed /usr/share/knowledge-layer/postgres-base-apk-installed.txt; \
    apk add --no-cache nghttp2-libs=1.70.0-r0 zlib=1.3.2-r1 \
        libcrypto3=3.5.9-r0 libssl3=3.5.9-r0; \
    apk info -e 'nghttp2-libs=1.70.0-r0'; \
    apk info -e 'zlib=1.3.2-r1'; \
    apk info -e 'libcrypto3=3.5.9-r0'; \
    apk info -e 'libssl3=3.5.9-r0'; \
    { \
      printf '%s\n' 'schema=knowledge-layer-postgres-runtime-v1' \
        'base_image=postgres:18.6-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873' \
        'removed_path=/usr/local/bin/gosu'; \
      printf 'removed_sha256=%s\n' "$(sha256sum /usr/local/bin/gosu | cut -d ' ' -f 1)"; \
      printf 'removed_version=%s\n' "$(/usr/local/bin/gosu --version)"; \
      printf 'base_apk_status_sha256=%s\n' "$(sha256sum /usr/share/knowledge-layer/postgres-base-apk-installed.txt | cut -d ' ' -f 1)"; \
      printf 'apk_status_sha256=%s\n' "$(sha256sum /lib/apk/db/installed | cut -d ' ' -f 1)"; \
      printf '%s\n' 'updated_package=nghttp2-libs=1.70.0-r0'; \
      printf '%s\n' 'patched_package=zlib=1.3.2-r1'; \
      printf '%s\n' 'patched_libcrypto=libcrypto3=3.5.9-r0'; \
      printf '%s\n' 'patched_libssl=libssl3=3.5.9-r0'; \
      printf 'upstream_entrypoint_sha256=%s\n' "$(sha256sum /usr/local/bin/docker-entrypoint.sh | cut -d ' ' -f 1)"; \
    } > /usr/share/knowledge-layer/postgres-runtime.txt; \
    rm /usr/local/bin/gosu; \
    test ! -e /usr/local/bin/gosu

COPY --chmod=755 <<'EOF' /usr/local/bin/knowledge-postgres-entrypoint
#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ]; then
    printf '%s\n' 'PostgreSQL requires a nonroot numeric UID; prepare data ownership on the host.' >&2
    exit 78
fi
exec /usr/local/bin/docker-entrypoint.sh "$@"
EOF

# The upstream NSS wrapper supports operator-selected numeric UIDs at initdb.
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/knowledge-postgres-entrypoint"]
CMD ["postgres"]
