# Optional evaluated profile; the strict vulnerability gate still applies.
FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS web-build
WORKDIR /web
RUN npm install --global npm@12.2.0
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS dependency-tools

FROM cgr.dev/chainguard/python:latest-dev@sha256:a876b1000774bdd68322ac020cd813aaf42b52941ca812f4d2f0149059bd0e67 AS runtime-build
USER 0:0
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY src ./src
ARG KNOWLEDGE_RUNTIME_EXTRAS=""
RUN --mount=from=dependency-tools,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    set -eu; set --; \
    for extra in $KNOWLEDGE_RUNTIME_EXTRAS; do \
        case "$extra" in \
            snowflake) echo "Snowflake requires an upstream OpenSSL 4 compatible adapter" >&2; exit 1 ;; \
            iceberg|objects|clickhouse|bigquery|drive|search|semantic-validation) ;; \
            *) echo "Unknown runtime extra" >&2; exit 1 ;; esac; \
        set -- "$@" --extra "$extra"; \
    done; \
    uv sync --python /usr/bin/python3.14 --frozen --no-dev --link-mode=copy "$@"
COPY --from=web-build /web/dist ./web/dist

# Keep the vendor's real package inventory and package SBOMs in the final root.
FROM cgr.dev/chainguard/python:latest@sha256:3de78d5699d76c56f74a4a47abcd81f22f5a16757eee9fac45837fb2ae3f0e06 AS runtime
USER 0:0
COPY --from=runtime-build /app /app
COPY scripts/build_runtime_root.py /tmp/build_runtime_root.py
COPY scripts/apply_runtime_patches.py /tmp/apply_runtime_patches.py
COPY third_party/runtime-patches /tmp/runtime-patches
RUN ["/app/.venv/bin/python", "-B", "/tmp/build_runtime_root.py", "--verify-wolfi"]
WORKDIR /app
ENV PATH="/app/.venv/bin:/usr/bin" PYTHONPATH="/app/src" KNOWLEDGE_WEB_DIST="/app/web/dist" PYTHONDONTWRITEBYTECODE="1" LANG="C.UTF-8"
USER 10001:10001
EXPOSE 8000
ENTRYPOINT []
CMD ["uvicorn", "knowledge_layer.platform:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--limit-concurrency", "64", "--timeout-keep-alive", "5"]
